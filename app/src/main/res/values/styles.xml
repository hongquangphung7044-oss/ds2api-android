<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 风格浅色主题（基于 Material Components，兼容纯代码构建的 Activity） -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- 主色 -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- 次要色 -->
        <item name="colorSecondary">#0EA5E9</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- 表面/背景 -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1F2937</item>
        <item name="android:colorBackground">#F8FAFC</item>
        <!-- 强调/错误 -->
        <item name="colorAccent">#2563EB</item>
        <item name="colorError">#DC2626</item>
        <!-- 状态栏 -->
        <item name="android:statusBarColor">#1D4ED8</item>
        <item name="android:textColorPrimary">#1F2937</item>
        <item name="android:textColorSecondary">#475569</item>
    </style>
</resources>
