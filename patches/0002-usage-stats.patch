diff --git a/internal/usagestats/usagestats.go b/internal/usagestats/usagestats.go
new file mode 100644
index 0000000..c406f7c
--- /dev/null
+++ b/internal/usagestats/usagestats.go
@@ -0,0 +1,392 @@
+// Package usagestats 提供独立于 chat-history 的 token 用量统计存储。
+//
+// 设计目标：
+//   - 不依赖 chathistory 的有界环形缓冲（默认 20 条、上限 50 条，超出物理删除）
+//   - 每次对话成功后由 chathistory.Store.Update 的 hook 调用 Record 累加
+//   - 持久化到 data/usage_stats.json，长期累积、不丢失
+//   - 按 日期 → 模型 → 账号 三维聚合，支持今日/累计/7日趋势/按模型/按账号 查询
+//
+// usage map 的 key 由不同 surface 产生，本模块统一归一化：
+//   - openai-chat:    prompt_tokens / completion_tokens / total_tokens
+//   - openai-responses: input_tokens / output_tokens / total_tokens
+//   - claude/generic: input_tokens / output_tokens / reasoning_tokens / total_tokens
+// 归一化后统一用 input_tokens / output_tokens / total_tokens（reasoning 已含在 output 内）。
+package usagestats
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+	"time"
+
+	// 嵌入 tzdata：Android 交叉编译二进制可能找不到系统时区库，
+	// 导致 time.Local 解析为 UTC。blank import 保证 LoadLocation 可用。
+	_ "time/tzdata"
+)
+
+// Stats 存储 usage 统计的全局单例。在 router.go 初始化时设置。
+var Stats = New(resolveDataDir())
+
+// statsLoc 是按日聚合使用的时区。
+// 优先级：DS2API_USAGE_TZ 环境变量 > time.Local > UTC。
+// 关键：必须用用户本地时区，否则 UTC 日的边界（北京 08:00）会让
+// 凌晨请求记到"昨天"，导致"今日用量不重置""7 日趋势不更新"。
+var statsLoc = resolveStatsLoc()
+
+func resolveStatsLoc() *time.Location {
+	if tz := os.Getenv("DS2API_USAGE_TZ"); tz != "" {
+		if loc, err := time.LoadLocation(tz); err == nil {
+			return loc
+		}
+	}
+	if loc, err := time.LoadLocation("Asia/Shanghai"); err == nil {
+		return loc // 默认中国时区（主要用户群），有 tzdata 兜底一定能加载
+	}
+	return time.UTC
+}
+
+// dailyKey 形如 "2026-07-30"（用户本地时区），用于按日聚合。
+func dailyKey(ts int64) string {
+	return time.UnixMilli(ts).In(statsLoc).Format("2006-01-02")
+}
+
+// modelDayAgg 是某模型在某日的聚合值。
+type modelDayAgg struct {
+	Input  int `json:"input_tokens"`
+	Output int `json:"output_tokens"`
+	Total  int `json:"total_tokens"`
+	Count  int `json:"request_count"`
+}
+
+// accountDayAgg 是某账号在某日的聚合值。
+type accountDayAgg struct {
+	Input  int `json:"input_tokens"`
+	Output int `json:"output_tokens"`
+	Total  int `json:"total_tokens"`
+	Count  int `json:"request_count"`
+}
+
+// dayAgg 是某日的总聚合（跨所有模型/账号）。
+type dayAgg struct {
+	Input     int                      `json:"input_tokens"`
+	Output    int                      `json:"output_tokens"`
+	Total     int                      `json:"total_tokens"`
+	Count     int                      `json:"request_count"`
+	Stream    int                      `json:"stream_count"`
+	ByModel   map[string]modelDayAgg   `json:"by_model"`
+	ByAccount map[string]accountDayAgg `json:"by_account"`
+}
+
+// fileStore 是持久化到磁盘的统计文件结构。
+type fileStore struct {
+	Version int                `json:"version"`
+	Days    map[string]*dayAgg `json:"days"` // key = "2026-07-30"
+}
+
+// Store 是 usage 统计存储。
+type Store struct {
+	mu   sync.Mutex
+	path string
+	data *fileStore
+}
+
+// New 创建并加载统计存储。
+func New(path string) *Store {
+	s := &Store{path: path, data: &fileStore{Version: 1, Days: make(map[string]*dayAgg)}}
+	s.load()
+	return s
+}
+
+// Path 返回存储文件路径。
+func (s *Store) Path() string {
+	if s == nil {
+		return ""
+	}
+	return s.path
+}
+
+func resolveDataDir() string {
+	return DefaultPath()
+}
+
+// DefaultPath 返回统计文件的默认路径。
+// 优先级：DS2API_USAGE_STATS_PATH > Vercel /tmp > chathistory 同目录 > data/usage_stats.json
+func DefaultPath() string {
+	if v := os.Getenv("DS2API_USAGE_STATS_PATH"); v != "" {
+		return v
+	}
+	// Vercel 只能写 /tmp
+	if os.Getenv("VERCEL") != "" || os.Getenv("NOW_REGION") != "" {
+		return "/tmp/usage_stats.json"
+	}
+	// 与 chathistory 同目录（data/），便于备份管理
+	if v := os.Getenv("DS2API_CHAT_HISTORY_PATH"); v != "" {
+		return filepath.Join(filepath.Dir(v), "usage_stats.json")
+	}
+	return "data/usage_stats.json"
+}
+
+// load 从磁盘加载统计文件。文件不存在或损坏时静默初始化空存储（不阻断服务）。
+func (s *Store) load() {
+	if s == nil || s.path == "" {
+		return
+	}
+	b, err := os.ReadFile(s.path)
+	if err != nil {
+		return // 文件不存在是正常情况（首次运行）
+	}
+	var fs fileStore
+	if err := json.Unmarshal(b, &fs); err != nil {
+		return // 损坏则忽略，用空存储
+	}
+	if fs.Days == nil {
+		fs.Days = make(map[string]*dayAgg)
+	}
+	s.data = &fs
+}
+
+// save 原子写盘。写失败不 panic（统计是 best-effort，不阻断请求链路）。
+func (s *Store) save() {
+	if s == nil || s.path == "" {
+		return
+	}
+	if err := os.MkdirAll(filepath.Dir(s.path), 0755); err != nil {
+		return
+	}
+	b, err := json.MarshalIndent(s.data, "", "  ")
+	if err != nil {
+		return
+	}
+	tmp := s.path + ".tmp"
+	if err := os.WriteFile(tmp, b, 0644); err != nil {
+		return
+	}
+	_ = os.Rename(tmp, s.path)
+}
+
+// NormalizeUsage 把不同 surface 的 usage map 归一化为 input/output/total。
+// 优先级：total_tokens 字段 > input+output 计算。
+func NormalizeUsage(usage map[string]any) (input, output, total int) {
+	if usage == nil {
+		return 0, 0, 0
+	}
+	input = toInt(usage["prompt_tokens"]) + toInt(usage["input_tokens"])
+	output = toInt(usage["completion_tokens"]) + toInt(usage["output_tokens"])
+	total = toInt(usage["total_tokens"])
+	if total == 0 && (input > 0 || output > 0) {
+		total = input + output
+	}
+	return input, output, total
+}
+
+func toInt(v any) int {
+	switch n := v.(type) {
+	case int:
+		return n
+	case int64:
+		return int(n)
+	case float64:
+		return int(n)
+	case json.Number:
+		i, _ := n.Int64()
+		return int(i)
+	default:
+		return 0
+	}
+}
+
+// Record 累加一次请求的 usage。线程安全。
+// 由 chathistory.Store.Update 在 params.Usage != nil 时调用。
+// model/accountID 为空时归为 "unknown"。total==0 的空 usage 不记录。
+func (s *Store) Record(model, accountID string, ts int64, usage map[string]any, stream bool) {
+	if s == nil {
+		return
+	}
+	input, output, total := NormalizeUsage(usage)
+	if total == 0 {
+		return // 空 usage 不记录
+	}
+	if model == "" {
+		model = "unknown"
+	}
+	if accountID == "" {
+		accountID = "unknown"
+	}
+	key := dailyKey(ts)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	day, ok := s.data.Days[key]
+	if !ok {
+		day = &dayAgg{ByModel: make(map[string]modelDayAgg), ByAccount: make(map[string]accountDayAgg)}
+		s.data.Days[key] = day
+	}
+	day.Input += input
+	day.Output += output
+	day.Total += total
+	day.Count++
+	if stream {
+		day.Stream++
+	}
+
+	m := day.ByModel[model]
+	m.Input += input
+	m.Output += output
+	m.Total += total
+	m.Count++
+	day.ByModel[model] = m
+
+	a := day.ByAccount[accountID]
+	a.Input += input
+	a.Output += output
+	a.Total += total
+	a.Count++
+	day.ByAccount[accountID] = a
+
+	s.save()
+}
+
+// Summary 是 /admin/usage 返回的聚合结果。
+type Summary struct {
+	Today                string         `json:"today"`                  // 今日日期 key（本地时区）
+	TodayStats           DaySummary     `json:"today_stats"`            // 今日汇总
+	TodayActiveAccounts  int            `json:"today_active_accounts"`  // 今日活跃账号数（与其它"今日"卡片口径一致）
+	TotalStats           DaySummary     `json:"total_stats"`            // 全部累计
+	Last7Days            []DaySummary   `json:"last_7_days"`            // 最近 7 天（始终 7 个柱，含今日，按日期升序，缺失补零）
+	ByModel              []ModelSummary `json:"by_model"`               // 按模型汇总（所选范围）
+	ByAccount            []ModelSummary `json:"by_account"`             // 按账号汇总（所选范围）
+}
+
+// DaySummary 是某日的聚合展示。
+type DaySummary struct {
+	Date   string `json:"date"`
+	Input  int    `json:"input_tokens"`
+	Output int    `json:"output_tokens"`
+	Total  int    `json:"total_tokens"`
+	Count  int    `json:"request_count"`
+	Stream int    `json:"stream_count"`
+}
+
+// ModelSummary 是某模型/账号的聚合展示。
+type ModelSummary struct {
+	Name   string `json:"name"`
+	Input  int    `json:"input_tokens"`
+	Output int    `json:"output_tokens"`
+	Total  int    `json:"total_tokens"`
+	Count  int    `json:"request_count"`
+}
+
+// Summary 返回聚合统计。rangeDays=0 表示全部，>0 表示最近 N 天（含今日）。
+func (s *Store) Summary(rangeDays int) Summary {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	// 关键：用 statsLoc（用户本地时区）计算"今日"和滚动窗口边界，
+	// 与 Record 写入时的 dailyKey 口径一致。若用 UTC，北京 00:00-08:00
+	// 的请求会落进 UTC 的"昨天"，导致"今日用量不重置""7 日趋势不更新"。
+	now := time.Now().In(statsLoc)
+	todayKey := now.Format("2006-01-02")
+	out := Summary{Today: todayKey}
+
+	// 收集所有日期 key 并排序
+	allKeys := make([]string, 0, len(s.data.Days))
+	for k := range s.data.Days {
+		allKeys = append(allKeys, k)
+	}
+	sort.Strings(allKeys)
+
+	// 今日（含今日活跃账号数，与其它"今日"卡片口径一致）
+	if d, ok := s.data.Days[todayKey]; ok {
+		out.TodayStats = DaySummary{
+			Date: todayKey, Input: d.Input, Output: d.Output,
+			Total: d.Total, Count: d.Count, Stream: d.Stream,
+		}
+		out.TodayActiveAccounts = len(d.ByAccount)
+	}
+
+	// 累计（全部日期）
+	var total DaySummary
+	for _, k := range allKeys {
+		d := s.data.Days[k]
+		total.Input += d.Input
+		total.Output += d.Output
+		total.Total += d.Total
+		total.Count += d.Count
+		total.Stream += d.Stream
+	}
+	total.Date = "all"
+	out.TotalStats = total
+
+	// 最近 7 天：以"今日"为右端点的滚动 7 日窗口（含今日）。
+	// 按本地时区日历逐日生成，缺失日期补零，确保始终 7 个柱；
+	// 下一个自然日到来后 now 滚动，窗口自动刷新（不会卡在固定日期）。
+	for i := 6; i >= 0; i-- {
+		dayKey := now.AddDate(0, 0, -i).Format("2006-01-02")
+		ds := DaySummary{Date: dayKey}
+		if d, ok := s.data.Days[dayKey]; ok {
+			ds.Input = d.Input
+			ds.Output = d.Output
+			ds.Total = d.Total
+			ds.Count = d.Count
+			ds.Stream = d.Stream
+		}
+		out.Last7Days = append(out.Last7Days, ds)
+	}
+
+	// 选定范围用于按模型/账号聚合：按日历取最近 rangeDays 天（0=全部）
+	var keys []string
+	if rangeDays > 0 {
+		start := now.AddDate(0, 0, -(rangeDays - 1)).Format("2006-01-02")
+		for _, k := range allKeys {
+			if k >= start {
+				keys = append(keys, k)
+			}
+		}
+	} else {
+		keys = allKeys
+	}
+
+	// 按模型/账号聚合（所选范围）
+	modelAgg := map[string]ModelSummary{}
+	accountAgg := map[string]ModelSummary{}
+	for _, k := range keys {
+		d := s.data.Days[k]
+		for name, m := range d.ByModel {
+			a := modelAgg[name]
+			a.Name = name
+			a.Input += m.Input
+			a.Output += m.Output
+			a.Total += m.Total
+			a.Count += m.Count
+			modelAgg[name] = a
+		}
+		for name, ac := range d.ByAccount {
+			a := accountAgg[name]
+			a.Name = name
+			a.Input += ac.Input
+			a.Output += ac.Output
+			a.Total += ac.Total
+			a.Count += ac.Count
+			accountAgg[name] = a
+		}
+	}
+	out.ByModel = toSortedSlice(modelAgg)
+	out.ByAccount = toSortedSlice(accountAgg)
+
+	return out
+}
+
+func toSortedSlice(m map[string]ModelSummary) []ModelSummary {
+	if len(m) == 0 {
+		return []ModelSummary{}
+	}
+	out := make([]ModelSummary, 0, len(m))
+	for _, v := range m {
+		out = append(out, v)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Total > out[j].Total })
+	return out
+}
