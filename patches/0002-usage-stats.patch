index 0000000..a4e9c27
--- /dev/null
+++ b/internal/httpapi/admin/usage/handler_usage.go
@@ -0,0 +1,37 @@
+package usage
+
+import (
+	"net/http"
+	"strconv"
+
+	"ds2api/internal/usagestats"
+	adminshared "ds2api/internal/httpapi/admin/shared"
+)
+
+// Handler 处理 /admin/usage 相关请求。
+type Handler struct {
+	Stats *usagestats.Store
+}
+
+var writeJSON = adminshared.WriteJSON
+
+// getUsage GET /admin/usage?range_days=7
+// range_days=0 表示全部，默认 7。
+func (h *Handler) getUsage(w http.ResponseWriter, r *http.Request) {
+	if h == nil || h.Stats == nil {
+		writeJSON(w, http.StatusOK, usagestats.Summary{
+			ByModel:   []usagestats.ModelSummary{},
+			ByAccount: []usagestats.ModelSummary{},
+			Last7Days: []usagestats.DaySummary{},
+		})
+		return
+	}
+	rangeDays := 7
+	if v := r.URL.Query().Get("range_days"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n >= 0 {
+			rangeDays = n
+		}
+	}
+	summary := h.Stats.Summary(rangeDays)
+	writeJSON(w, http.StatusOK, summary)
+}
